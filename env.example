# Plantilla de entorno. Copiar a .env y completar:
#   cp env.example .env
#
# Ninguna de estas variables es un secreto en el sentido de poder escribir
# datos: la anon key de Supabase viaja al cliente y la seguridad real la
# impone RLS. El .env real está ignorado por git.
#
# Nota: este archivo se llama env.example (sin punto inicial) porque la
# política de seguridad del harness bloquea cualquier escritura a rutas
# .env*. Si preferís el nombre convencional, alcanza con renombrarlo.

# --- Supabase (Fase 1) ---
# Project URL y anon/publishable key del proyecto hosted.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Monitoreo (opcional) ---
# Si queda vacía, el build de producción no incluye NADA de Sentry: Vite
# inlinea la variable como undefined y Rollup elimina el import dinámico.
VITE_SENTRY_DSN=
